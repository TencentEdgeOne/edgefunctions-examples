---
import { getCategoriesWithExamples } from '../data/index';

const categories = getCategoriesWithExamples();
---

<div
  role="tablist"
  aria-label="Example categories"
  class="flex flex-col md:flex-row md:flex-wrap gap-3"
>
  {categories.map((category, index) => (
    <button
      role="tab"
      id={`pill-${category.id}`}
      aria-selected={index === 0 ? "true" : "false"}
      tabindex={index === 0 ? 0 : -1}
      data-category-id={category.id}
      class:list={[
        'pill',
        'border border-border border-l-[3px] rounded-tag',
        'px-5 py-3 md:px-4 md:py-2.5 text-sm font-medium',
        'cursor-pointer',
        'transition-colors duration-150 ease',
        'hover:border-accent-gold hover:text-text-headline',
        'focus-visible:outline-2 focus-visible:outline-accent-gold focus-visible:outline-offset-2',
        'w-full md:w-auto text-left',
        index === 0 ? 'bg-accent-gold text-white border-accent-gold' : 'bg-bg-card text-text-body',
      ]}
      style={`border-left-color: var(--color-${category.color})`}
    >
      {category.label} · {category.count}
    </button>
  ))}
</div>

<script>
  function initCategoryPills() {
    const tablist = document.querySelector('[role="tablist"][aria-label="Example categories"]');
    if (!tablist) return;

    const tabs = tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]');

    const activeClasses = ['bg-accent-gold', 'text-white', 'border-accent-gold'];
    const inactiveClasses = ['bg-bg-card', 'text-text-body'];

    function activateTab(tab: HTMLButtonElement) {
      tabs.forEach((t) => {
        t.setAttribute('aria-selected', 'false');
        t.tabIndex = -1;
        activeClasses.forEach((c) => t.classList.remove(c));
        inactiveClasses.forEach((c) => t.classList.add(c));
      });

      tab.setAttribute('aria-selected', 'true');
      tab.tabIndex = 0;
      inactiveClasses.forEach((c) => tab.classList.remove(c));
      activeClasses.forEach((c) => tab.classList.add(c));

      document.dispatchEvent(
        new CustomEvent('category-change', {
          detail: { categoryId: tab.dataset.categoryId },
        })
      );

      sessionStorage.setItem('activeCategoryId', tab.dataset.categoryId || '');
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activateTab(tab));
    });

    // Keyboard navigation: ArrowLeft/ArrowRight/Home/End
    const tabArr = Array.from(tabs);
    tabArr.forEach((tab) => {
      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        const idx = tabArr.indexOf(tab);
        let newIdx = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          newIdx = (idx + 1) % tabArr.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          newIdx = (idx - 1 + tabArr.length) % tabArr.length;
        } else if (e.key === 'Home') {
          newIdx = 0;
        } else if (e.key === 'End') {
          newIdx = tabArr.length - 1;
        }
        if (newIdx >= 0) {
          e.preventDefault();
          activateTab(tabArr[newIdx]);
          tabArr[newIdx].focus();
        }
      });
    });

    // Restore previously selected pill from sessionStorage
    const saved = sessionStorage.getItem('activeCategoryId');
    if (saved) {
      const savedTab = tablist.querySelector<HTMLButtonElement>(`[data-category-id="${saved}"]`);
      if (savedTab) activateTab(savedTab);
    }
  }

  initCategoryPills();
  document.addEventListener('astro:after-swap', initCategoryPills);
</script>
