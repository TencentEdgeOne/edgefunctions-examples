---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — EdgeOne Function Examples" description="The page you are looking for does not exist.">
  <section class="flex flex-col items-center justify-center py-32 text-center">
    <h1 class="text-text-headline text-2xl font-bold mb-6">
      Example not found
    </h1>
    <a
      href="/"
      class="inline-block bg-accent-gold text-white font-medium px-6 py-3 rounded-[var(--radius-btn)] hover:bg-accent-gold-hover transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-accent-gold focus-visible:outline-offset-2"
    >
      ← Back to examples
    </a>
  </section>
</BaseLayout>
