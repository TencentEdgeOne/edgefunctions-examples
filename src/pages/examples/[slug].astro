---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DetailHeader from '../../components/DetailHeader.astro';
import TabPanel from '../../components/TabPanel.astro';
import { getExampleBySlug, getCategoryById } from '../../data';
import CTAButton from '../../components/CTAButton.astro';
import CodeViewer from '../../components/CodeViewer.astro';
import { renderMarkdown } from '../../utils/markdown';
import { highlightCode } from '../../utils/shiki';

function escapeHtml(s: string) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

const { slug } = Astro.params;
const example = getExampleBySlug(slug!);

if (!example) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const category = getCategoryById(example.category);
const categoryLabel = category ? category.label : example.category;
const categoryColor = category ? category.color : 'category-geo';

// Read README file
const projectRoot = path.resolve(import.meta.dirname, '../../..');
const readmePath = path.join(projectRoot, example.readme);

let docHtml: string;
try {
  let readmeContent = fs.readFileSync(readmePath, 'utf-8');
  // Rewrite relative image paths (../assets/images/xxx) to absolute (/assets/images/xxx)
  readmeContent = readmeContent.replace(
    /\.\.\/(assets\/images\/[^)\s]+)/g,
    '/$1'
  );
  docHtml = await renderMarkdown(readmeContent);
} catch {
  // Fallback: show title + summary (HTML-escaped to prevent XSS)
  docHtml = `<h2>${escapeHtml(example.title)}</h2><p>${escapeHtml(example.summary)}</p>`;
}

const tabs = [
  { id: 'doc', label: 'Doc' },
  { id: 'code', label: 'Code' },
  { id: 'live', label: 'Live ▸' },
];

// Read source file and highlight
const sourcePath = path.join(projectRoot, example.sourceFile);
let codeHtml: string;
try {
  const sourceCode = fs.readFileSync(sourcePath, 'utf-8');
  codeHtml = await highlightCode(sourceCode, 'javascript');
} catch {
  codeHtml = '';
}
---

<BaseLayout
  title={`${example.title} — EdgeOne Function Examples`}
  description={example.summary}
>
  <DetailHeader
    title={example.title}
    categoryLabel={categoryLabel}
    categoryColor={categoryColor}
  />

  <TabPanel tabs={tabs} activeTab="doc">
    <div slot="doc" class="bg-bg-card rounded-[var(--radius-card)] p-6">
      <div class="markdown-body" set:html={docHtml} />
    </div>
    <div slot="code">
      {codeHtml ? (
        <CodeViewer code={codeHtml} />
      ) : (
        <div class="bg-bg-card rounded-[var(--radius-card)] p-6">
          <p class="text-text-muted text-sm">Source code not available</p>
        </div>
      )}
    </div>
    <div slot="live" class="bg-bg-card rounded-[var(--radius-card)] p-6">
      <p class="text-text-body mb-6">
        See this edge function running in a live environment
      </p>
      {example.onlineExampleUrl ? (
        <CTAButton
          href={example.onlineExampleUrl}
          label="View Online Example →"
        />
      ) : (
        <CTAButton
          href="#"
          label="No online example available"
          disabled
        />
      )}
      {!example.playgroundReady && (
        <div class="mt-4">
          <CTAButton
            href="#"
            label="Playground — Coming Soon"
            disabled
          />
        </div>
      )}
    </div>
  </TabPanel>
</BaseLayout>

<style>
  /* Markdown body typography — scoped to detail page */
  .markdown-body :global(h1),
  .markdown-body :global(h2),
  .markdown-body :global(h3),
  .markdown-body :global(h4) {
    color: var(--color-text-headline);
    font-weight: 700;
    line-height: 1.3;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .markdown-body :global(h1) { font-size: 1.5rem; }
  .markdown-body :global(h2) { font-size: 1.25rem; }
  .markdown-body :global(h3) { font-size: 1.1rem; }

  .markdown-body :global(p) {
    margin-bottom: 1em;
    line-height: 1.7;
  }

  .markdown-body :global(a) {
    color: var(--color-accent-gold);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .markdown-body :global(a:hover) {
    color: var(--color-accent-gold-hover);
  }

  .markdown-body :global(code) {
    background: var(--color-bg-code);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .markdown-body :global(pre) {
    background: var(--color-bg-code);
    padding: 16px;
    border-radius: var(--radius-code);
    overflow-x: auto;
    margin-bottom: 1em;
  }
  .markdown-body :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .markdown-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1em;
    font-size: 0.875rem;
  }
  .markdown-body :global(th),
  .markdown-body :global(td) {
    border: 1px solid var(--color-border);
    padding: 8px 12px;
    text-align: left;
  }
  .markdown-body :global(th) {
    background: var(--color-bg);
    color: var(--color-text-headline);
    font-weight: 600;
  }

  .markdown-body :global(ul),
  .markdown-body :global(ol) {
    padding-left: 1.5em;
    margin-bottom: 1em;
  }
  .markdown-body :global(li) {
    margin-bottom: 0.25em;
    line-height: 1.6;
  }

  .markdown-body :global(img) {
    max-width: 100%;
    border-radius: var(--radius-card);
    margin: 1em 0;
  }

  .markdown-body :global(blockquote) {
    border-left: 3px solid var(--color-accent-gold);
    padding-left: 1em;
    margin: 1em 0;
    color: var(--color-text-muted);
  }

  .markdown-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2em 0;
  }

  /* First child: remove top margin */
  .markdown-body :global(:first-child) {
    margin-top: 0;
  }
</style>
