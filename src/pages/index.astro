---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ExampleCard from '../components/ExampleCard.astro';
import IntegrationGrid from '../components/IntegrationGrid.astro';
import { getExamples, getCategoryById, getCategoriesWithExamples } from '../data/index';

const examples = getExamples();
const categoriesWithCount = getCategoriesWithExamples();

// Map slugs to preview images where they exist
const previewMap: Record<string, string> = {
  'geolocation-info': '/assets/images/geolocation-info.avif',
  'ab-testing': '/assets/images/ab-testing.png',
  'caching-post-requests': '/assets/images/caching-post-requests-cache.avif',
  'rsa-digital-signature': '/assets/images/rsa-digital-signature.avif',
  'combine-data-in-streaming-mode': '/assets/images/combine-data-in-streaming-mode.avif',
  'referer-hotlink-protection': '/assets/images/referer-hotlink-protection-granted.avif',
  'redirect-based-on-the-location': '/assets/images/redirect-based-on-the-location.avif',
  'request-redirect': '/assets/images/request-redirect.avif',
  'm3u8-rewrite-authentication': '/assets/images/m3u8-rewrite-auth.avif',
  'post-json': '/assets/images/post-json.avif',
  'alter-response-headers': '/assets/images/alter-response-headers.avif',
  'protecting-data-from-tampering': '/assets/images/protecting-data-from-tampering-same.avif',
};
---

<BaseLayout>
  {/* Full-width Hero */}
  <Hero />

  {/* Main content area */}
  <div class="max-w-[1472px] mx-auto px-6 lg:px-12">
    {/* Split-screen layout: sticky left + scrolling right */}
    <section class="flex flex-col lg:flex-row items-start gap-8 lg:gap-16 w-full py-16 lg:py-24">

      {/* Left Sticky Panel */}
      <div class="lg:sticky lg:top-[80px] w-full lg:w-[320px] flex flex-col shrink-0">
        <h2 class="text-text-headline text-[24px] font-bold leading-[1.2] tracking-[1px] mb-2 uppercase"
            style="font-family: 'Orbitron', sans-serif;">
          Explore
        </h2>
        <p class="text-[15px] leading-[1.5] text-text-body mb-8">
          Filter by category or scroll through all examples.
        </p>

        {/* Category Legend */}
        <div class="flex flex-col gap-1 mb-8">
          <span class="text-text-muted text-[10px] font-mono uppercase tracking-[2px] mb-2">
            Categories
          </span>
          {categoriesWithCount.map((cat) => (
            <button
              data-filter-category={cat.id}
              class="category-filter flex items-center gap-3 py-2 px-3 -mx-3 rounded-[8px]
                     transition-all duration-150 ease cursor-pointer
                     hover:bg-bg-card
                     focus-visible:outline-2 focus-visible:outline-accent-gold focus-visible:outline-offset-2
                     text-left"
            >
              <div
                class="w-[6px] h-[6px] rounded-full shrink-0"
                style={`background-color: var(--color-${cat.color})`}
              />
              <span class="text-text-body text-[14px]">{cat.label}</span>
              <span class="text-text-muted text-[12px] font-mono ml-auto">{cat.count}</span>
            </button>
          ))}
          <button
            data-filter-category="all"
            class="category-filter flex items-center gap-3 py-2 px-3 -mx-3 rounded-[8px]
                   transition-all duration-150 ease cursor-pointer
                   hover:bg-bg-card
                   focus-visible:outline-2 focus-visible:outline-accent-gold focus-visible:outline-offset-2
                   text-left mt-2 border-t border-bg-stroke pt-3"
          >
            <div class="w-[6px] h-[6px] rounded-full shrink-0 bg-accent-gold" />
            <span class="text-text-body text-[14px]">All Examples</span>
            <span class="text-text-muted text-[12px] font-mono ml-auto">{examples.length}</span>
          </button>
        </div>

        {/* Scroll hint */}
        <p class="text-text-muted text-[11px] font-mono hidden lg:block" aria-hidden="true">
          ↓ Scroll to explore
        </p>
      </div>

      {/* Right Scrollable Card Grid */}
      <div class="example-list w-full lg:flex-1 flex flex-col gap-6 pb-24">
        {examples.map((example) => {
          const cat = getCategoryById(example.category);
          if (!cat) return null;
          return (
            <ExampleCard
              example={example}
              category={cat}
              previewImage={previewMap[example.slug]}
            />
          );
        })}
      </div>
    </section>
  </div>

  {/* Integration Grid — tech stack showcase */}
  <IntegrationGrid />
</BaseLayout>

<script>
  function initShowcaseFilters() {
    const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter-category]');
    const cards = document.querySelectorAll<HTMLDivElement>('.example-card');

    const activeClass = 'bg-bg-card';

    // Mark "all" as initially active
    const allBtn = document.querySelector('[data-filter-category="all"]');
    if (allBtn) allBtn.classList.add(activeClass);

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        const catId = btn.dataset.filterCategory || 'all';

        // Update active state
        filters.forEach((f) => f.classList.remove(activeClass));
        btn.classList.add(activeClass);

        // Filter cards
        cards.forEach((card) => {
          if (catId === 'all' || card.dataset.category === catId) {
            card.style.display = '';
            card.style.opacity = '0';
            requestAnimationFrame(() => {
              card.style.transition = 'opacity 0.25s ease';
              card.style.opacity = '1';
            });
          } else {
            card.style.opacity = '0';
            setTimeout(() => {
              card.style.display = 'none';
            }, 250);
          }
        });

        sessionStorage.setItem('activeCategoryId', catId);
      });
    });

    // Restore saved filter
    const saved = sessionStorage.getItem('activeCategoryId');
    if (saved && saved !== 'all') {
      const savedBtn = document.querySelector<HTMLButtonElement>(`[data-filter-category="${saved}"]`);
      if (savedBtn) savedBtn.click();
    }
  }

  initShowcaseFilters();
  document.addEventListener('astro:after-swap', initShowcaseFilters);
</script>
